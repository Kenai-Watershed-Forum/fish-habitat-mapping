import arcpy

# --- CONFIGURATION: Change these names if they don't match your map exactly ---
stream_layer = "netmap_focus_hucs_clip_20260508" 
id_field = "ID"
downid_field = "DOWNID"
# ------------------------------------------------------------------------------

# 1. Grab the IDs of the stream segments that currently have fish
fish_bearing_ids = set()
with arcpy.da.SearchCursor(stream_layer, [id_field]) as cursor:
    for row in cursor:
        if row[0] is not None:
            fish_bearing_ids.add(row[0])

# 2. Build the structural network tree (Downstream ID -> list of Upstream IDs)
network = {}
with arcpy.da.SearchCursor(stream_layer, [id_field, downid_field]) as cursor:
    for id_val, down_id in cursor:
        if down_id not in network:
            network[down_id] = []
        network[down_id].append(id_val)

# 3. Crawl strictly upstream from the fish locations
queue = list(fish_bearing_ids)
upstream_ids = set()

while queue:
    current = queue.pop(0)
    if current in network:
        for up_id in network[current]:
            if up_id not in fish_bearing_ids and up_id not in upstream_ids:
                upstream_ids.add(up_id)
                queue.append(up_id)

# 4. Wipe out selections and mass-calculate the fields directly in the database
arcpy.management.SelectLayerByAttribute(stream_layer, "CLEAR_SELECTION")

with arcpy.da.UpdateCursor(stream_layer, [id_field, "fishstatus"]) as cursor:
    for row in cursor:
        if row[0] in upstream_ids:
            row[1] = "Unknown"
        else:
            row[1] = "Present"
        cursor.updateRow(row)

print(f"Success! Marked {len(upstream_ids)} upper branches as Unknown. All other segments set to Present.")
```

